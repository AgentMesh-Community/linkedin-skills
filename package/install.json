{
  "format": "agent-install-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [
    {
      "name": "apify-token",
      "kind": "service",
      "credential": "apify-token",
      "env": "APIFY_TOKEN",
      "spends": {
        "unit": "calls"
      }
    },
    {
      "name": "publora-api-key",
      "kind": "service",
      "credential": "publora-api-key",
      "env": "PUBLORA_API_KEY"
    }
  ],
  "ceilings": [
    {
      "system": "apify-token",
      "per": "task",
      "enforced_by": "runtime"
    }
  ],
  "directories": [
    {
      "name": "records",
      "purpose": "every record the descriptor names"
    },
    {
      "name": "work",
      "purpose": "inputs and drafts in progress"
    }
  ],
  "job_seconds": 900,
  "price": {
    "sku": "default",
    "covers": {
      "agent": true
    },
    "price": {
      "model": "free"
    }
  }
}
